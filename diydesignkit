<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lake Hazel — DIY Design Kit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Karla:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --sand:#F5F0E8;--sand-dark:#E8E0D0;--clay:#C4A882;--clay-deep:#9B7D5A;
  --charcoal:#2C2825;--warm-white:#FDFAF5;--sage:#8A9E8C;--terra:#C4714A;
  --muted:#7A746E;--border:rgba(44,40,37,0.12);--r:2px;
}
html,body{height:100%;font-family:'Karla',sans-serif;background:var(--warm-white);color:var(--charcoal)}
body{display:flex;flex-direction:column;min-height:100vh}
.kit-header{background:var(--charcoal);padding:1.5rem 2.5rem 1.25rem;display:flex;align-items:flex-end;justify-content:space-between;flex-shrink:0}
.kit-logo{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--clay);display:block;margin-bottom:4px}
.kit-title{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:28px;color:var(--warm-white);letter-spacing:.5px;line-height:1.1}
.kit-title em{font-style:italic;color:var(--clay)}
.cart-pill{display:flex;align-items:center;gap:8px;background:rgba(196,168,130,.15);border:1px solid var(--clay);padding:6px 14px;border-radius:20px;cursor:pointer;color:var(--clay);font-size:12px;letter-spacing:1px;transition:background .2s;flex-shrink:0}
.cart-pill:hover{background:rgba(196,168,130,.25)}
.cart-count{background:var(--clay);color:var(--warm-white);width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500}
.prog-bar{background:var(--charcoal);padding:0 2.5rem;display:flex;border-bottom:1px solid rgba(255,255,255,.08);overflow-x:auto;flex-shrink:0}
.step-tab{flex:1;padding:10px 6px 9px;font-size:9.5px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(253,250,245,.3);border-bottom:2px solid transparent;cursor:pointer;transition:all .2s;text-align:center;font-family:'Karla',sans-serif;font-weight:400;background:none;border-top:none;border-left:none;border-right:none;white-space:nowrap;min-width:56px}
.step-tab:hover{color:rgba(253,250,245,.55)}
.step-tab.active{color:var(--clay);border-bottom-color:var(--clay)}
.step-tab.done{color:rgba(253,250,245,.45)}
.content-wrap{flex:1;overflow-y:auto}
.content{padding:2rem 2.5rem 3rem;min-height:460px}
.step-panel{display:none;animation:fadeIn .25s ease}
.step-panel.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.step-intro{display:flex;align-items:baseline;gap:14px;margin-bottom:1.4rem;padding-bottom:1.2rem;border-bottom:1px solid var(--border)}
.step-num{font-family:'Cormorant Garamond',serif;font-size:40px;font-weight:300;color:var(--clay);line-height:1;min-width:30px}
.step-heading{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:300}
.step-heading em{font-style:italic;color:var(--clay-deep)}
.step-desc{font-size:12px;color:var(--muted);line-height:1.6;margin-top:3px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem}
.fl{font-size:10.5px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:5px;font-weight:500;display:block}
.fi{width:100%;padding:9px 12px;border:1px solid var(--border);background:var(--warm-white);font-family:'Karla',sans-serif;font-size:13px;color:var(--charcoal);border-radius:var(--r);outline:none;transition:border-color .2s;appearance:none}
.fi:focus{border-color:var(--clay)}
textarea.fi{resize:vertical;min-height:75px}
.field-group{margin-bottom:1rem}
.tip{background:var(--sand);border-left:3px solid var(--clay);padding:12px 14px;border-radius:0 var(--r) var(--r) 0;margin:10px 0}
.tip-t{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--clay-deep);font-weight:500;margin-bottom:4px}
.tip-b{font-size:12px;color:var(--charcoal);line-height:1.6}
.lrh-tip{background:var(--charcoal);color:var(--warm-white);padding:13px 16px;border-radius:var(--r);margin-top:1rem}
.lrh-tip-t{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--clay);font-weight:500;margin-bottom:5px}
.lrh-tip-b{font-size:12px;color:rgba(253,250,245,.75);line-height:1.6}
.res-badge{background:var(--charcoal);color:var(--warm-white);padding:8px 14px;border-radius:var(--r);font-size:12px;font-weight:500;display:flex;align-items:center;justify-content:space-between;margin-top:.75rem}
.res-badge span{color:var(--clay);font-family:'Cormorant Garamond',serif;font-size:20px}
.upload-zone{border:1.5px dashed var(--clay);background:rgba(196,168,130,.04);border-radius:var(--r);padding:1.75rem;text-align:center;cursor:pointer;transition:background .2s}
.upload-zone:hover{background:rgba(196,168,130,.09)}
.upload-icon{font-size:26px;color:var(--clay);margin-bottom:7px}
.ul-label{font-size:12px;color:var(--muted)}
.ul-label strong{color:var(--clay-deep);font-weight:500}
.file-list{margin-top:9px}
.fchip{display:inline-flex;align-items:center;gap:5px;background:var(--sand);padding:3px 10px;border-radius:20px;font-size:11px;color:var(--charcoal);margin:2px}
.hidden{display:none}
.dim-row{display:grid;grid-template-columns:1fr 18px 1fr 1fr;align-items:center;gap:8px;margin-bottom:8px}
.dim-sep{text-align:center;color:var(--muted);font-size:15px}
.vibe-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:.8rem}
.vibe-card{border:1.5px solid var(--border);border-radius:var(--r);padding:.9rem;cursor:pointer;transition:all .2s;position:relative}
.vibe-card:hover{border-color:var(--clay)}
.vibe-card.selected{border-color:var(--clay);background:rgba(196,168,130,.08)}
.vibe-card.selected::after{content:'✓';position:absolute;top:8px;right:10px;color:var(--clay);font-size:13px}
.vibe-sw{height:36px;border-radius:var(--r);margin-bottom:9px;display:flex;gap:3px;overflow:hidden}
.vibe-sw span{flex:1}
.vibe-n{font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:400;margin-bottom:3px}
.vibe-d{font-size:11px;color:var(--muted);line-height:1.5}
.rng-wrap{display:flex;align-items:center;gap:12px}
.rng-wrap input[type=range]{flex:1;accent-color:var(--clay);cursor:pointer}
.rng-val{min-width:68px;text-align:right;font-family:'Cormorant Garamond',serif;font-size:20px;color:var(--clay-deep)}
.scale-tool{background:var(--sand);border-radius:var(--r);padding:1.3rem;margin-top:.8rem}
.scale-vis{position:relative;height:130px;background:white;border:1px solid var(--border);border-radius:var(--r);margin:.8rem 0;overflow:hidden}
.rules-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:.8rem}
.rule-card{padding:13px 15px;border-radius:var(--r);border:1px solid var(--border)}
.rule-card.do{border-color:var(--sage);background:rgba(138,158,140,.06)}
.rule-card.dont{border-color:var(--terra);background:rgba(196,113,74,.06)}
.rule-head{font-size:10px;letter-spacing:2px;text-transform:uppercase;font-weight:500;margin-bottom:8px}
.rule-card.do .rule-head{color:var(--sage)}
.rule-card.dont .rule-head{color:var(--terra)}
.rule-item{font-size:11.5px;color:var(--charcoal);line-height:1.75;padding:1px 0}
.budget-row{display:grid;grid-template-columns:1fr 90px 95px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid var(--border);font-size:12px}
.budget-row.hdr{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);font-weight:500}
.bbar-wrap{height:5px;background:var(--sand-dark);border-radius:3px;margin-top:3px;overflow:hidden}
.bbar{height:100%;border-radius:3px;background:var(--clay);transition:width .5s ease}
.btotal{display:flex;justify-content:space-between;align-items:baseline;padding:10px 0 0;border-top:1.5px solid var(--charcoal);margin-top:4px}
.btotal-l{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);font-weight:500}
.btotal-a{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:300;color:var(--charcoal)}
.finish-tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:1.2rem;overflow-x:auto}
.ftab{padding:9px 18px;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);border-bottom:2px solid transparent;cursor:pointer;background:none;border-top:none;border-left:none;border-right:none;font-family:'Karla',sans-serif;font-weight:500;white-space:nowrap;transition:all .2s}
.ftab:hover{color:var(--clay-deep)}
.ftab.active{color:var(--clay-deep);border-bottom-color:var(--clay)}
.finish-panel{display:none}
.finish-panel.active{display:block}
.finish-category-label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);font-weight:500;margin-bottom:.8rem;padding-bottom:.4rem;border-bottom:1px solid var(--border)}
.color-family-row{display:flex;gap:7px;margin-bottom:1rem;flex-wrap:wrap}
.cf-btn{padding:5px 13px;font-size:10px;letter-spacing:1px;text-transform:uppercase;cursor:pointer;border-radius:20px;border:1px solid var(--border);background:none;color:var(--muted);font-family:'Karla',sans-serif;transition:all .2s}
.cf-btn:hover{border-color:var(--clay);color:var(--clay-deep)}
.cf-btn.active{border-color:var(--clay);color:var(--clay-deep);background:rgba(196,168,130,.1)}
.swatch-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:1.4rem}
.swatch-card{border:1.5px solid var(--border);border-radius:var(--r);overflow:hidden;cursor:pointer;transition:border-color .2s;position:relative}
.swatch-card:hover{border-color:var(--clay)}
.swatch-card.selected{border-color:var(--clay-deep);border-width:2px}
.swatch-card.selected::after{content:'✓';position:absolute;top:5px;right:7px;color:var(--charcoal);font-size:13px;font-weight:600;text-shadow:0 0 6px rgba(253,250,245,.9)}
.swatch-color{height:72px;width:100%}
.swatch-pattern{height:72px;width:100%;display:flex;align-items:center;justify-content:center;font-size:30px;background:var(--sand)}
.swatch-body{padding:9px 10px;background:var(--warm-white)}
.swatch-name{font-size:11.5px;font-weight:500;color:var(--charcoal);margin-bottom:1px;line-height:1.3}
.swatch-meta{font-size:10px;color:var(--muted)}
.swatch-brand{font-size:10px;color:var(--muted);margin-top:1px}
.swatch-price{font-size:11px;color:var(--clay-deep);font-weight:500;margin-top:4px}
.finish-add-btn{display:inline-flex;align-items:center;gap:4px;padding:5px 11px;font-size:9.5px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:var(--r);font-family:'Karla',sans-serif;font-weight:500;background:var(--charcoal);border:1px solid var(--charcoal);color:var(--warm-white);margin-top:6px;transition:all .2s}
.finish-add-btn:hover{background:var(--clay-deep);border-color:var(--clay-deep)}
.finish-add-btn.added{background:var(--sage);border-color:var(--sage)}
.finish-selected-bar{background:var(--sand);border:1px solid var(--border);border-radius:var(--r);padding:11px 14px;margin-bottom:1rem;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.finish-chip{display:inline-flex;align-items:center;gap:7px;background:var(--warm-white);border:1px solid var(--border);border-radius:var(--r);padding:4px 10px;font-size:11px;margin:2px}
.finish-chip-dot{width:13px;height:13px;border-radius:1px;border:1px solid rgba(0,0,0,.1);flex-shrink:0}
.finish-chip-x{cursor:pointer;color:var(--muted);margin-left:3px;font-size:12px;font-weight:500}
.finish-chip-x:hover{color:var(--terra)}
.style-badge{display:inline-flex;align-items:center;gap:5px;font-size:10px;padding:3px 10px;border-radius:10px;background:rgba(196,168,130,.15);color:var(--clay-deep);margin-bottom:.6rem}
.prod-filter-row{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:1rem}
.filt-btn{padding:5px 13px;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:20px;border:1px solid var(--border);background:none;color:var(--muted);font-family:'Karla',sans-serif;font-weight:500;transition:all .2s}
.filt-btn:hover{border-color:var(--clay);color:var(--clay-deep)}
.filt-btn.active{border-color:var(--clay);color:var(--clay-deep);background:rgba(196,168,130,.08)}
.prod-section{margin-top:1.5rem}
.prod-section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem}
.prod-section-title{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:300}
.prod-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.prod-card{border:1px solid var(--border);border-radius:var(--r);overflow:hidden;transition:border-color .2s}
.prod-card:hover{border-color:var(--clay)}
.prod-img{height:96px;display:flex;align-items:center;justify-content:center;font-size:34px;border-bottom:1px solid var(--border);background:var(--sand)}
.prod-body{padding:10px 11px}
.prod-name{font-size:12.5px;font-weight:500;color:var(--charcoal);margin-bottom:2px;line-height:1.3}
.prod-retailer{font-size:10.5px;color:var(--muted);margin-bottom:6px}
.prod-price{font-family:'Cormorant Garamond',serif;font-size:17px;color:var(--clay-deep)}
.prod-footer{display:flex;align-items:center;justify-content:space-between;margin-top:7px;gap:5px}
.prod-style-tag{font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:2px 8px;border-radius:10px;background:var(--sand);color:var(--clay-deep)}
.btn-add{padding:5px 10px;font-size:9.5px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:var(--r);font-family:'Karla',sans-serif;font-weight:500;background:var(--charcoal);border:1px solid var(--charcoal);color:var(--warm-white);transition:all .2s}
.btn-add:hover{background:var(--clay-deep);border-color:var(--clay-deep)}
.btn-add.added{background:var(--sage);border-color:var(--sage)}
.cart-header-row{display:grid;grid-template-columns:1fr 100px 100px 30px;gap:8px;padding:7px 0;border-bottom:1px solid var(--border);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted)}
.cart-item{display:grid;grid-template-columns:1fr 100px 100px 30px;gap:8px;padding:10px 0;border-bottom:1px solid var(--border);align-items:center}
.ci-name{font-size:12.5px;font-weight:500}
.ci-cat{font-size:10px;color:var(--muted);margin-top:2px}
.ci-retailer{font-size:11px;color:var(--muted)}
.ci-price{font-family:'Cormorant Garamond',serif;font-size:16px;color:var(--clay-deep);text-align:right}
.ci-remove{cursor:pointer;color:var(--muted);font-size:14px;text-align:center;transition:color .15s}
.ci-remove:hover{color:var(--terra)}
.cart-total-row{display:flex;justify-content:space-between;align-items:baseline;padding:14px 0 0;border-top:1.5px solid var(--charcoal);margin-top:5px}
.cart-total-l{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);font-weight:500}
.cart-total-a{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:300}
.cart-budget-bar{height:8px;border-radius:4px;background:var(--sand-dark);overflow:hidden;margin-top:10px}
.cart-budget-fill{height:100%;border-radius:4px;transition:width .4s}
.cart-budget-label{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:5px}
.section-divider{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--clay);font-weight:500;padding:10px 0 5px;margin-top:6px;border-top:1px dashed var(--border)}
.cart-empty{text-align:center;padding:3rem 1rem;color:var(--muted)}

/* ── CONTACT FORM & SUBMIT ── */
.contact-form{background:var(--sand);border-radius:var(--r);padding:1.75rem;margin-top:1.5rem}
.contact-form-title{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:300;margin-bottom:4px}
.contact-form-title em{font-style:italic;color:var(--clay)}
.contact-form-desc{font-size:12px;color:var(--muted);margin-bottom:1.25rem;line-height:1.6}
.submit-btn{width:100%;padding:14px;font-family:'Karla',sans-serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;border-radius:var(--r);font-weight:500;background:var(--charcoal);border:1px solid var(--charcoal);color:var(--warm-white);transition:all .2s;margin-top:1rem}
.submit-btn:hover:not(:disabled){background:var(--clay-deep);border-color:var(--clay-deep)}
.submit-btn:disabled{opacity:.5;cursor:not-allowed}
.submit-status{margin-top:1rem;padding:14px 16px;border-radius:var(--r);font-size:13px;display:none}
.submit-status.success{background:rgba(138,158,140,.15);border:1px solid var(--sage);color:var(--charcoal);display:block}
.submit-status.error{background:rgba(196,113,74,.1);border:1px solid var(--terra);color:var(--terra);display:block}
.submit-status-title{font-weight:500;margin-bottom:4px}

.summary-dark{background:var(--charcoal);border-radius:var(--r);padding:2rem;color:var(--warm-white);margin-top:1.5rem}
.sum-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem}
.sum-section{padding-bottom:1rem;margin-bottom:1rem;border-bottom:1px solid rgba(255,255,255,.1)}
.sum-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--clay);margin-bottom:5px;font-weight:500}
.sum-val{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:300}
.over{color:var(--terra)!important}

.nav-row{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 2.5rem;border-top:1px solid var(--border);background:var(--sand);flex-shrink:0}
.btn-nav{padding:10px 22px;font-family:'Karla',sans-serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:var(--r);font-weight:500;transition:all .2s}
.btn-back{background:none;border:1px solid var(--border);color:var(--muted)}
.btn-back:hover{border-color:var(--clay);color:var(--clay-deep)}
.btn-next{background:var(--charcoal);border:1px solid var(--charcoal);color:var(--warm-white)}
.btn-next:hover{background:var(--clay-deep);border-color:var(--clay-deep)}
.step-ctr{font-size:11px;color:var(--muted);letter-spacing:1px}

@media(max-width:680px){
  .kit-header{padding:1.2rem 1.25rem 1rem}
  .prog-bar{padding:0 1.25rem}
  .content{padding:1.5rem 1.25rem 2.5rem}
  .nav-row{padding:1rem 1.25rem}
  .g2,.g3,.vibe-grid,.swatch-grid,.prod-grid,.rules-grid{grid-template-columns:1fr}
  .cart-header-row,.cart-item{grid-template-columns:1fr 80px 80px 24px}
  .sum-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<header class="kit-header">
  <div>
    <span class="kit-logo">Lake Hazel Design</span>
    <h1 class="kit-title">DIY Design <em>Kit</em></h1>
  </div>
  <div class="cart-pill" onclick="goToStep(8)" role="button" aria-label="View my list">
    <i class="ti ti-shopping-bag" aria-hidden="true"></i>
    My List
    <span class="cart-count" id="cartCount">0</span>
  </div>
</header>

<nav class="prog-bar" aria-label="Kit steps">
  <button class="step-tab active" onclick="goToStep(0)">01 Room</button>
  <button class="step-tab" onclick="goToStep(1)">02 Measure</button>
  <button class="step-tab" onclick="goToStep(2)">03 Style</button>
  <button class="step-tab" onclick="goToStep(3)">04 Scale</button>
  <button class="step-tab" onclick="goToStep(4)">05 Rules</button>
  <button class="step-tab" onclick="goToStep(5)">06 Budget</button>
  <button class="step-tab" onclick="goToStep(6)">07 Finishes</button>
  <button class="step-tab" onclick="goToStep(7)">08 Shop</button>
  <button class="step-tab" onclick="goToStep(8)">09 Submit</button>
</nav>

<div class="content-wrap">
<main class="content">

<!-- STEP 1 -->
<section class="step-panel active" id="step-0">
  <div class="step-intro"><div class="step-num">01</div><div><h2 class="step-heading">Tell us about your <em>space</em></h2><p class="step-desc">Your answers shape every recommendation — finishes, furnishings, and budget — throughout the kit.</p></div></div>
  <div class="g2">
    <div>
