function getSqft(){return parseFloat(document.getElementById('sqftVal').textContent)||150;}
function calcSqft(){const l=parseFloat(document.getElementById('roomL').value)||0,w=parseFloat(document.getElementById('roomW').value)||0,h=parseFloat(document.getElementById('roomH').value)||0;if(l&&w){document.getElementById('sqftVal').textContent=Math.round(l*w)+' sq ft';const r=(l/w).toFixed(2);document.getElementById('ratioVal').textContent=(r>1.5?'Long & narrow':r<0.8?'Wide & short':'Well-proportioned')+' ('+r+':1)';if(h)document.getElementById('wallSqft').textContent=Math.round(2*(l+w)*h)+' sq ft';}}
function updateScale(){const w=parseInt(document.getElementById('rwRange').value);document.getElementById('rwVal').textContent=w+' ft';const mn=Math.round(w*0.55*12),mx=Math.round(w*0.67*12);document.getElementById('sofaLen').textContent=mn+'–'+mx+' in';document.getElementById('rugSize').textContent=w<=10?'5×8':w<=14?'8×10':w<=18?'9×12':'10×14';const vis=document.getElementById('scaleVis');const pct=Math.round((mx/(w*12))*68);vis.innerHTML=`<div style="position:absolute;top:8px;left:8px;right:8px;bottom:8px;border:2px dashed var(--clay);border-radius:2px"><div style="position:absolute;bottom:12px;left:50%;transform:translateX(-50%);width:${pct}%;height:24px;background:rgba(196,168,130,.3);border:1.5px solid var(--clay);border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--clay-deep);font-weight:500;letter-spacing:1px">SOFA</div><div style="position:absolute;top:12px;left:8%;width:16%;height:34px;background:rgba(196,168,130,.2);border:1px solid var(--clay);border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:8px;color:var(--clay-deep)">CHAIR</div><div style="position:absolute;top:12px;right:8%;width:16%;height:34px;background:rgba(196,168,130,.2);border:1px solid var(--clay);border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:8px;color:var(--clay-deep)">CHAIR</div></div>`;}
function updateBudget(){const total=parseInt(document.getElementById('totalBudget').value);document.getElementById('budgetVal').textContent='$'+total.toLocaleString();const room=document.getElementById('budgetRoom').value,allocs=BUDGET_ALLOCS[room];let html='<div class="budget-row hdr"><span>Category</span><span></span><span style="text-align:right">Amount</span></div>';allocs.forEach(a=>{const amt=Math.round(total*a.pct/100);html+=`<div class="budget-row"><div><span style="font-size:12px">${a.cat}</span><div class="bbar-wrap"><div class="bbar" style="width:${a.pct}%"></div></div></div><span style="color:var(--muted);font-size:10px">${a.pct}%</span><span style="color:var(--clay-deep);font-weight:500;text-align:right;font-size:12px">$${amt.toLocaleString()}</span></div>`;});html+=`<div class="btotal"><span class="btotal-l">Total</span><span class="btotal-a">$${total.toLocaleString()}</span></div>`;document.getElementById('budgetBreakdown').innerHTML=html;}
function selectVibe(el,name){document.querySelectorAll('.vibe-card').forEach(c=>c.classList.remove('selected'));el.classList.add('selected');selectedVibe=name;}
function handleFiles(input,listId){const list=document.getElementById(listId);list.innerHTML='';Array.from(input.files).forEach(f=>{const chip=document.createElement('span');chip.className='fchip';chip.innerHTML=`<i class="ti ti-file" aria-hidden="true"></i>${f.name.length>20?f.name.substring(0,20)+'…':f.name}`;list.appendChild(chip);});}

function renderSwatchGrid(containerId,items,type){
  const sqft=getSqft();let html='';
  items.forEach(item=>{
    const isSel=selectedFinishes[item.id];
    const isHw=type==='hardware'||type==='counter';
    const qty=isHw?1:type==='paint'?Math.ceil(sqft/350):Math.ceil(sqft*1.15);
    const est=isHw?item.price:Math.round(item.price*qty);
    const qLabel=type==='paint'?` · ~${qty} gal = $${est.toLocaleString()}`:isHw?'':` · ~${qty} sq ft = $${est.toLocaleString()}`;
    html+=`<div class="swatch-card ${isSel?'selected':''}" id="sw-${item.id}">${item.hex?`<div class="swatch-color" style="background:${item.hex}"></div>`:`<div class="swatch-pattern">${item.emoji||'◼'}</div>`}<div class="swatch-body"><p class="swatch-name">${item.name}${item.splurge?' ★':''}</p>${item.code?`<p class="swatch-meta">${item.code}</p>`:''}<p class="swatch-brand">${item.brand}</p><p class="swatch-price">$${item.price.toLocaleString()} ${item.unit}${qLabel}</p><button class="finish-add-btn ${isSel?'added':''}" id="fbtn-${item.id}" onclick="toggleFinish('${item.id}','${type}')">${isSel?'✓ Selected':'+ Select'}</button></div></div>`;
  });
  document.getElementById(containerId).innerHTML=html||'<p style="color:var(--muted);font-size:13px;padding:1rem 0">No items in this filter.</p>';
}
function toggleFinish(id,type){
  const maps={paint:PAINTS,tile:TILES,flooring:FLOORS,carpet:CARPETS,counter:COUNTERS,hardware:HARDWARE};
  const item=maps[type].find(d=>d.id===id);if(!item)return;
  const sqft=getSqft();const isHw=type==='hardware'||type==='counter';
  const qty=isHw?1:type==='paint'?Math.ceil(sqft/350):Math.ceil(sqft*1.15);
  const est=isHw?item.price:Math.round(item.price*qty);
  if(selectedFinishes[id]){delete selectedFinishes[id];const idx=cart.findIndex(c=>c.id===id);if(idx>-1)cart.splice(idx,1);}
  else{selectedFinishes[id]=true;cart.push({...item,category:'Finishes — '+type.charAt(0).toUpperCase()+type.slice(1),price:est,retailer:item.brand,emoji:item.emoji||'🎨',isFinish:true});}
  document.getElementById('cartCount').textContent=cart.length;
  const btn=document.getElementById('fbtn-'+id),sw=document.getElementById('sw-'+id);
  if(btn){btn.textContent=selectedFinishes[id]?'✓ Selected':'+ Select';btn.classList.toggle('added',!!selectedFinishes[id]);}
  if(sw)sw.classList.toggle('selected',!!selectedFinishes[id]);
  updateFinishChips();
}
function updateFinishChips(){
  const bar=document.getElementById('finishSelectedBar'),chips=document.getElementById('finishChips');
  const keys=Object.keys(selectedFinishes);bar.style.display=keys.length?'block':'none';
  const all=[...PAINTS,...TILES,...FLOORS,...CARPETS,...COUNTERS,...HARDWARE];
  chips.innerHTML=keys.map(id=>{const item=all.find(d=>d.id===id);if(!item)return'';return`<span class="finish-chip"><span class="finish-chip-dot" style="${item.hex?`background:${item.hex}`:'background:var(--sand)'}"></span>${item.name}<span class="finish-chip-x" onclick="toggleFinish('${id}','${getFinishType(id)}')" aria-label="Remove">×</span></span>`;}).join('');
}
function getFinishType(id){if(PAINTS.find(d=>d.id===id))return'paint';if(TILES.find(d=>d.id===id))return'tile';if(FLOORS.find(d=>d.id===id))return'flooring';if(CARPETS.find(d=>d.id===id))return'carpet';if(COUNTERS.find(d=>d.id===id))return'counter';return'hardware';}
function switchFinishTab(tab,btn){document.querySelectorAll('.ftab').forEach(t=>t.classList.remove('active'));btn.classList.add('active');document.querySelectorAll('.finish-panel').forEach(p=>p.classList.remove('active'));document.getElementById('f'+tab).classList.add('active');const maps={paint:['paintGrid',PAINTS],tile:['tileGrid',TILES],flooring:['floorGrid',FLOORS],carpet:['carpetGrid',CARPETS],counter:['counterGrid',COUNTERS],hardware:['hardwareGrid',HARDWARE]};if(maps[tab])renderSwatchGrid(maps[tab][0],maps[tab][1],tab);}
function makeFilter(items,grid,type,field,val,btn,rowSel){document.querySelectorAll(rowSel+' .cf-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderSwatchGrid(grid,val==='all'?items:items.filter(i=>i[field]===val),type);}
function filterPaint(v,b){makeFilter(PAINTS,'paintGrid','paint','family',v,b,'#fpaint .color-family-row');}
function filterTile(v,b){makeFilter(TILES,'tileGrid','tile','family',v,b,'#ftile .color-family-row');}
function filterFloor(v,b){makeFilter(FLOORS,'floorGrid','flooring','family',v,b,'#fflooring .color-family-row');}
function filterCarpet(v,b){makeFilter(CARPETS,'carpetGrid','carpet','family',v,b,'#fcarpet .color-family-row');}
function filterCounter(v,b){makeFilter(COUNTERS,'counterGrid','counter','family',v,b,'#fcounter .color-family-row');}
function filterHardware(v,b){makeFilter(HARDWARE,'hardwareGrid','hardware','family',v,b,'#fhardware .color-family-row');}

function buildShop(){
  const vibe=selectedVibe||'Warm Organic';const prods=PRODUCTS[vibe]||PRODUCTS['Warm Organic'];
  let html=`<div class="style-badge"><i class="ti ti-palette" aria-hidden="true" style="font-size:11px;margin-right:2px"></i>Showing picks for: ${vibe}</div>`;
  html+=`<div class="prod-filter-row"><button class="filt-btn active" onclick="filterShop('all',this)">All</button><button class="filt-btn" onclick="filterShop('Seating',this)">Seating</button><button class="filt-btn" onclick="filterShop('Tables',this)">Tables</button><button class="filt-btn" onclick="filterShop('Rugs',this)">Rugs</button><button class="filt-btn" onclick="filterShop('Lighting',this)">Lighting</button><button class="filt-btn" onclick="filterShop('Accessories',this)">Accessories</button></div>`;
  Object.entries(prods).forEach(([cat,items])=>{html+=`<div class="prod-section" data-cat="${cat}"><div class="prod-section-head"><h3 class="prod-section-title">${cat}</h3></div><div class="prod-grid">`;items.forEach(p=>{const inCart=cart.find(c=>c.id===p.id);html+=`<div class="prod-card"><div class="prod-img">${p.emoji}</div><div class="prod-body"><p class="prod-name">${p.name}</p><p class="prod-retailer">${p.retailer}${p.splurge?' · ★ Splurge':''}</p><p class="prod-price">$${p.price.toLocaleString()}</p><div class="prod-footer"><span class="prod-style-tag">${cat.toLowerCase()}</span><button class="btn-add ${inCart?'added':''}" id="btn-${p.id}" onclick="toggleCart('${p.id}')">${inCart?'✓ Added':'+ Add'}</button></div></div></div>`;});html+='</div></div>';});
  document.getElementById('shopContent').innerHTML=html;
}
function filterShop(cat,btn){document.querySelectorAll('.filt-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');document.querySelectorAll('.prod-section').forEach(s=>{s.style.display=(cat==='all'||s.dataset.cat===cat)?'block':'none';});}
function toggleCart(id){const vibe=selectedVibe||'Warm Organic';const prods=PRODUCTS[vibe]||PRODUCTS['Warm Organic'];let prod=null;Object.entries(prods).forEach(([cat,items])=>{const f=items.find(p=>p.id===id);if(f)prod={...f,category:cat};});if(!prod)return;const idx=cart.findIndex(c=>c.id===id);if(idx>-1){cart.splice(idx,1);}else{cart.push(prod);}document.getElementById('cartCount').textContent=cart.length;const btn=document.getElementById('btn-'+id);if(btn){const inCart=!!cart.find(c=>c.id===id);btn.textContent=inCart?'✓ Added':'+ Add';btn.classList.toggle('added',inCart);}}

function buildCart(){
  const budget=parseInt(document.getElementById('totalBudget').value)||8000;
  const total=cart.reduce((s,p)=>s+p.price,0);
  const pct=Math.min(Math.round((total/budget)*100),100);const over=total>budget;
  const fi=cart.filter(i=>i.isFinish),fu=cart.filter(i=>!i.isFinish);
  let html='';
  if(cart.length===0){html=`<div class="cart-empty"><i class="ti ti-shopping-bag" aria-hidden="true" style="font-size:28px;display:block;margin-bottom:10px;color:var(--sand-dark)"></i><p style="font-size:13px">No items added yet.</p><p style="font-size:11px;margin-top:6px;color:var(--muted)">Visit the Finishes and Shop steps to build your list.</p></div>`;}
  else{
    html='<div class="cart-header-row"><span>Item</span><span>Source</span><span style="text-align:right">Est. cost</span><span></span></div>';
    if(fi.length){html+='<p class="section-divider">Finishes & materials</p>';fi.forEach(p=>{html+=cartRow(p);});}
    if(fu.length){html+='<p class="section-divider">Furnishings & accessories</p>';fu.forEach(p=>{html+=cartRow(p);});}
    html+=`<div class="cart-total-row"><span class="cart-total-l">Estimated total</span><span class="cart-total-a" style="color:${over?'var(--terra)':'var(--charcoal)'}">${over?'⚠ ':''} $${total.toLocaleString()}</span></div>`;
    html+=`<div class="cart-budget-bar"><div class="cart-budget-fill" style="width:${pct}%;background:${over?'var(--terra)':'var(--clay)'}"></div></div>`;
    html+=`<div class="cart-budget-label"><span>${pct}% of $${budget.toLocaleString()} budget used</span><span style="${over?'color:var(--terra)':''}">${over?'$'+(total-budget).toLocaleString()+' over budget':'$'+(budget-total).toLocaleString()+' remaining'}</span></div>`;
  }
  document.getElementById('cartContent').innerHTML=html;
  document.getElementById('sum-room').textContent=document.getElementById('roomType').value||'—';
  document.getElementById('sum-style').textContent=selectedVibe||'—';
  document.getElementById('sum-sqft').textContent=document.getElementById('sqftVal').textContent||'—';
  document.getElementById('sum-budget').textContent=document.getElementById('budgetVal').textContent||'—';
}
function cartRow(p){return`<div class="cart-item"><div><p class="ci-name">${p.emoji||''} ${p.name}</p><p class="ci-cat">${p.category}</p></div><span class="ci-retailer">${p.retailer}</span><span class="ci-price">$${p.price.toLocaleString()}</span><span class="ci-remove" onclick="removeItem('${p.id}',${!!p.isFinish})" role="button" aria-label="Remove ${p.name}"><i class="ti ti-x"></i></span></div>`;}
function removeItem(id,isFinish){const idx=cart.findIndex(c=>c.id===id);if(idx>-1)cart.splice(idx,1);if(isFinish){delete selectedFinishes[id];updateFinishChips();const btn=document.getElementById('fbtn-'+id),sw=document.getElementById('sw-'+id);if(btn){btn.textContent='+ Select';btn.classList.remove('added');}if(sw)sw.classList.remove('selected');}else{const btn=document.getElementById('btn-'+id);if(btn){btn.textContent='+ Add';btn.classList.remove('added');}}document.getElementById('cartCount').textContent=cart.length;buildCart();}

/* ══════════════════════════════════════
   CLICKUP SUBMISSION
══════════════════════════════════════ */
async function submitToClickUp(){
  const name  = document.getElementById('clientName').value.trim();
  const email = document.getElementById('clientEmail').value.trim();
  const phone = document.getElementById('clientPhone').value.trim();
  const city  = document.getElementById('clientCity').value.trim();
  const notes = document.getElementById('clientNotes').value.trim();
  const statusEl = document.getElementById('submitStatus');
  const btn = document.getElementById('submitBtn');

  if(!name){alert('Please enter your name.');return;}
  if(!email){alert('Please enter your email address.');return;}

  btn.disabled=true;
  btn.textContent='Sending…';
  statusEl.className='submit-status';
  statusEl.style.display='none';

  const budget  = parseInt(document.getElementById('totalBudget').value)||8000;
  const roomT   = document.getElementById('roomType').value||'Not specified';
  const roomUse = document.getElementById('roomUse').value||'';
  const pain    = document.getElementById('painPoints').value||'';
  const sqft    = document.getElementById('sqftVal').textContent||'—';
  const total   = cart.reduce((s,p)=>s+p.price,0);
  const fi      = cart.filter(i=>i.isFinish);
  const fu      = cart.filter(i=>!i.isFinish);

  const finishLines = fi.length
    ? fi.map(p=>`  • ${p.name} (${p.retailer}) — $${p.price.toLocaleString()}`).join('\n')
    : '  None selected';
  const furnLines = fu.length
    ? fu.map(p=>`  • ${p.name} | ${p.category} | ${p.retailer} — $${p.price.toLocaleString()}`).join('\n')
    : '  None selected';
  const over = total > budget;
  const budgetLine = over
    ? `$${total.toLocaleString()} (⚠ $${(total-budget).toLocaleString()} over budget)`
    : `$${total.toLocaleString()} ($${(budget-total).toLocaleString()} remaining)`;

  const description = `🏠 DIY DESIGN KIT SUBMISSION
Submitted via lakehazeldesign.com

━━━ CLIENT INFO ━━━
Name:    ${name}
Email:   ${email}
Phone:   ${phone||'Not provided'}
City:    ${city||'Not provided'}

━━━ ROOM DETAILS ━━━
Room type:      ${roomT}
Style:          ${selectedVibe||'Not selected'}
Square footage: ${sqft}
Total budget:   $${budget.toLocaleString()}
Primary use:    ${roomUse||'Not provided'}
Pain points:    ${pain||'Not provided'}

━━━ FINISHES & MATERIALS ━━━
${finishLines}

━━━ FURNISHINGS & ACCESSORIES ━━━
${furnLines}

━━━ LIST TOTAL ━━━
${budgetLine}

━━━ NOTES FROM CLIENT ━━━
${notes||'None'}`;

  const taskName = `DIY Kit — ${name} — ${roomT} (${selectedVibe||'Style TBD'})`;

  try{
    const res = await fetch(CU_URL, {
      method: 'POST',
      headers: {
        'Authorization': CU_TOKEN,
        'Content-Type':  'application/json'
      },
      body: JSON.stringify({
        name: taskName,
        description: description,
        priority: 2,
        status: 'Open',
        custom_fields: []
      })
    });

    if(res.ok){
      const data = await res.json();
      statusEl.className='submit-status success';
      statusEl.innerHTML=`<p class="submit-status-title">✓ Your list has been sent to Lake Hazel!</p><p style="font-size:12px;margin-top:4px">We'll review your design brief and be in touch within 1–2 business days at <strong>${email}</strong>. We're excited to see your space!</p>`;
      btn.textContent='List sent ✓';
      btn.style.background='var(--sage)';
      btn.style.borderColor='var(--sage)';
    } else {
      const err = await res.json().catch(()=>({}));
      throw new Error(err.err||`Status ${res.status}`);
    }
  } catch(e){
    statusEl.className='submit-status error';
    statusEl.innerHTML=`<p class="submit-status-title">Something went wrong</p><p style="font-size:12px;margin-top:4px">Error: ${e.message}. Please email your list directly to <a href="mailto:info@lakehazeldesign.com" style="color:var(--terra)">info@lakehazeldesign.com</a>.</p>`;
    btn.disabled=false;
    btn.textContent='Try again →';
  }
}

/* ══════════════════════════════════════
   NAVIGATION
══════════════════════════════════════ */
function goToStep(n){
  if(n<0||n>=TOTAL_STEPS)return;
  document.getElementById('step-'+currentStep).classList.remove('active');
  document.querySelectorAll('.step-tab').forEach((t,i)=>{t.classList.remove('active','done');if(i<n)t.classList.add('done');if(i===n)t.classList.add('active');});
  currentStep=n;
  document.getElementById('step-'+currentStep).classList.add('active');
  document.getElementById('stepCtr').textContent='Step '+(currentStep+1)+' of '+TOTAL_STEPS;
  document.getElementById('backBtn').style.visibility=currentStep===0?'hidden':'visible';
  document.getElementById('nextBtn').textContent=currentStep===TOTAL_STEPS-1?'Done':'Next →';
  document.querySelector('.content-wrap').scrollTop=0;
  if(currentStep===6)renderSwatchGrid('paintGrid',PAINTS,'paint');
  if(currentStep===7)buildShop();
  if(currentStep===8)buildCart();
}
function changeStep(dir){goToStep(currentStep+dir);}

updateBudget();updateScale();
document.getElementById('backBtn').style.visibility='hidden';
</script>
